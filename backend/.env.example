# =========================================================
# VetCare API · Variables de entorno
# Copie este archivo como .env y complete los valores.
# NUNCA suba el archivo .env al repositorio.
# =========================================================

# ----- Servidor -----
NODE_ENV=development
PORT=3100

# ----- Base de datos MySQL -----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vetcare_db
DB_USER=root
DB_PASSWORD=
DB_POOL=10
# true si el proveedor en la nube exige SSL (Aiven: true · Railway: false)
DB_SSL=false
# Zona horaria de la clínica para NOW()/CURDATE() (Ecuador = -05:00)
DB_TIME_ZONE=-05:00

# ----- Seguridad (JWT) -----
# Genere una clave aleatoria: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
LOGIN_MAX_INTENTOS=20

# ----- CORS: orígenes del Frontend permitidos (separados por coma) -----
CORS_ORIGENES=http://localhost:4200

# ----- URL pública del Frontend (destino del código QR del carnet) -----
FRONTEND_URL=http://localhost:4200

# ----- Alertas automáticas del calendario de vacunación -----
ALERTA_HABILITADA=true
ALERTA_DIAS_ANTICIPACION=7
# Expresión cron (por defecto: cada hora en el minuto 0)
ALERTA_CRON=0 * * * *

# ----- Facturación -----
# IVA aplicado a los servicios (Ecuador: 15 %) y RUC que aparece en la factura
IVA_PORCENTAJE=15
CLINICA_RUC=0190000000001

# ----- Datos de la clínica (encabezado del PDF) -----
CLINICA_NOMBRE=Clínica Veterinaria VetCare
CLINICA_DIRECCION=Av. de las Américas y Av. Huayna Cápac, Cuenca - Ecuador
CLINICA_TELEFONO=07-288-0000

# ----- Correo de alertas (recordatorios de vacunas, controles y citas) -----
# Proveedor: brevo (API HTTP, recomendado y obligatorio en Railway) · smtp (Outlook/Gmail en su PC) · vacío = desactivado
MAIL_PROVEEDOR=
# Remitente: el correo del administrador
MAIL_REMITENTE=javier.carrera2004@est.ucacue.edu.ec
MAIL_NOMBRE_REMITENTE=VetCare · Administración
# Modo demostración: si se define, TODOS los correos llegan a esta dirección (no a los propietarios)
MAIL_REDIRIGIR_A=
# Copia oculta opcional para el administrador
MAIL_COPIA_ADMIN=
# SMTP (MAIL_PROVEEDOR=smtp). Outlook/Microsoft 365: smtp.office365.com y puerto 587 (si la institución lo permite)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=javier.carrera2004@est.ucacue.edu.ec
SMTP_PASS=
# Brevo (MAIL_PROVEEDOR=brevo): clave API de https://app.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=
