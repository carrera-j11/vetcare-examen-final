# =========================================================
# VetCare API · Variables de entorno
# Copie este archivo como .env y complete los valores.
# NUNCA suba el archivo .env al repositorio.
# =========================================================

# ----- Servidor -----
NODE_ENV=development
PORT=3100

# ----- Base de datos MySQL -----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vetcare_db
DB_USER=root
DB_PASSWORD=
DB_POOL=10
# true si el proveedor en la nube exige SSL (Aiven: true · Railway: false)
DB_SSL=false
# Zona horaria de la clínica para NOW()/CURDATE() (Ecuador = -05:00)
DB_TIME_ZONE=-05:00

# ----- Seguridad (JWT) -----
# Genere una clave aleatoria: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
LOGIN_MAX_INTENTOS=20

# ----- CORS: orígenes del Frontend permitidos (separados por coma) -----
CORS_ORIGENES=http://localhost:4200

# ----- URL pública del Frontend (destino del código QR del carnet) -----
FRONTEND_URL=http://localhost:4200

# ----- Alertas automáticas del calendario de vacunación -----
ALERTA_HABILITADA=true
ALERTA_DIAS_ANTICIPACION=7
# Expresión cron (por defecto: cada hora en el minuto 0)
ALERTA_CRON=0 * * * *

# ----- Datos de la clínica (encabezado del PDF) -----
CLINICA_NOMBRE=Clínica Veterinaria VetCare
CLINICA_DIRECCION=Av. de las Américas y Av. Huayna Cápac, Cuenca - Ecuador
CLINICA_TELEFONO=07-288-0000
